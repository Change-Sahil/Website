# Kopiere diese Datei nach .env.local und trage deine echten Werte ein.
# Teile .env.local NIEMALS in einem Git-Repository!

# Vercel / Next.js
NEXT_DISABLE_TURBOPACK=1

# Öffentliche Site-URL (kein trailing slash)
NEXT_PUBLIC_SITE_URL=https://change-werkstatt-sahil.de

# Resend API – https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absenderadresse. Die DOMAIN muss in Resend verifiziert sein, sonst lassen sich
# nur Mails an die eigene Kontoadresse versenden. Siehe docs/mailversand-einrichten.md
CONTACT_FROM_EMAIL=info@change-werkstatt-sahil.de

# Tatsächlich gelesenes Postfach: interne Benachrichtigungen und Antworten auf
# den Ergebnisbericht landen hier. Muss nicht auf der Absenderdomain liegen.
CONTACT_TO_EMAIL=seref.sahil@change-werkstatt-sahil.com

# ── Übergabe-Check (Supabase) ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API Keys → service_role (secret)
# ACHTUNG: umgeht Row Level Security. Niemals mit NEXT_PUBLIC_ prefixen,
# nicht im Client verwenden, nicht ins Repository committen.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
