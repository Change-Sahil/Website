# Kopiere diese Datei nach .env.local und trage deine echten Werte ein.
# Teile .env.local NIEMALS in einem Git-Repository!

# Vercel / Next.js
NEXT_DISABLE_TURBOPACK=1

# Öffentliche Site-URL (kein trailing slash)
NEXT_PUBLIC_SITE_URL=https://change-werkstatt-sahil.de

# Resend API – https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absender-E-Mail-Adresse (muss in Resend verifiziert sein)
CONTACT_FROM_EMAIL=info@change-werkstatt-sahil.de
